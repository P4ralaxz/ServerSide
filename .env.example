# คัดลอกเป็น .env แล้วแก้ค่า — ห้าม commit .env
NODE_ENV=development

# พอร์ตฝั่ง host ทุกตัวอ่านจากไฟล์นี้ (แอปและ docker-compose ใช้ไฟล์เดียวกัน)
# เลี่ยงเลขมาตรฐาน 3000 / 5432 / 8025 / 1025 เพราะเครื่อง dev มีโปรเจกต์อื่นใช้อยู่
API_PORT=3100
DB_PORT=5434
# รหัสผ่านของ Postgres ใน docker-compose — ค่าสำหรับ dev เท่านั้น ต้องตรงกับใน DATABASE_URL ข้างล่าง
DB_PASSWORD=dorm
MAILPIT_WEB_PORT=8026
MAILPIT_SMTP_PORT=1026

# พอร์ตและรหัสผ่านในบรรทัดนี้ต้องตรงกับ DB_PORT / DB_PASSWORD ข้างบน (dotenv ไม่แทนค่าตัวแปรให้)
DATABASE_URL=postgres://dorm:dorm@localhost:5434/dorm

# ค่าสำหรับ dev เท่านั้น — ของจริงต้องสุ่มใหม่ (อย่างน้อย 32 ตัวอักษร) และสองค่านี้ห้ามเป็นค่าเดียวกัน
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-jwt-secret-change-me-0000000000
OTP_SECRET=dev-only-otp-secret-change-me-1111111111
JWT_EXPIRES_IN=8h

# เมล OTP — dev ส่งเข้า Mailpit ที่ localhost:MAILPIT_SMTP_PORT (ไม่ต้องตั้งค่าข้างล่างเพิ่ม)
SMTP_HOST=localhost

# เมลเซิร์ฟเวอร์จริง (เปิดให้คนอื่นใช้) — เอา # ออกแล้วใส่ค่าของผู้ให้บริการเมล จากนั้นลองด้วย
#   npm run mail:test -- you@kmitl.ac.th
# ตัวอย่าง Gmail: ต้องเปิด 2-Step Verification แล้วสร้าง App password (ไม่ใช่รหัสผ่าน Gmail ปกติ)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true เมื่อใช้พอร์ต 465
# SMTP_USER=your.account@gmail.com
# SMTP_PASS=app-password-16-ตัว
# MAIL_FROM=ระบบแจ้งซ่อมหอพัก <your.account@gmail.com>

# ใช้ต่อเป็นลิงก์ในอีเมลแจ้งผลซ่อม (DESIGN 6.10)
APP_BASE_URL=http://localhost:3100

# job ปิดอัตโนมัติ (DESIGN 6.6) — dev ปิด cron ไว้ ไม่งั้นใบเดโมถูกปิดเองภายใน 15 นาทีหลัง seed
AUTO_CLOSE_AFTER_HOURS=72
AUTO_CLOSE_CRON_ENABLED=false

# เปิดเมื่อรันหลัง tunnel บนเครื่องเดียวกัน (cloudflared / ngrok) — ให้โควตาต่อ IP นับตาม IP จริงของผู้ใช้
# อย่าเปิดถ้าแอปรับ request จากอินเทอร์เน็ตตรง ๆ โดยไม่มี proxy คั่น
TRUST_PROXY=false
